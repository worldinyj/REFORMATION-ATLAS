  "accessibility_contract": [
    "responsive_mobile_navigation",
    "esc_to_close_and_focus_return",
    "touch_target_at_least_44px_recommended",
    "body_text_at_least_16px",
    "zero_horizontal_overflow",
    "long_korean_latin_name_wrap",
    "keyboard_and_screen_reader",
    "reduced_motion"
