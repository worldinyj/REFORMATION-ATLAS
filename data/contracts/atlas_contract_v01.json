  "entity_key_rules": {
    "global_entity_prefixes": [
      "PER",
      "MOV",
      "EVT",
      "LOC",
      "REL"
    ],
    "source_prefixes": [
      "SRC",
      "Vxx-Syy"
    ],
    "per_volume_prefixes": [
      "CLM-Vxx",
      "MAP-Vxx",
      "PRT-Vxx",
      "ILL-Vxx",
      "DOC-Vxx",
      "EDN-Vxx",
      "TRN-Vxx",
      "EVR-Vxx"
    ],
    "stable_ids": true,
    "no_reuse": true,
    "no_reindex_on_volume_move": true,
    "authority_rule_ko": "하나의 역사 인물은 각 권에서 재생성하지 않고 기존 글로벌 ID를 참조한다.",
    "relation_identity_ko": "원본 관계 ID는 독립 레코드로 남기며 직접 사제 관계와 수용·문헌 영향은 구분한다."
  },
  "normalized_projection_v01": {
    "purpose": "forward-compatible read-only view, not automatic replacement of current JSON",
    "required": [
      "id",
      "type",
      "title_ko",
      "volume_ids",
      "source_ids",
      "review_status",
      "public_visible"
    ],
    "optional": [
      "date",
      "certainty",
      "statement_access",
      "entity_links",
      "asset_state",
      "caption_ko",
      "rights_status",
      "human_approval_ref"
    ],
    "date": {
      "required_when_timeline": true,
      "fields": [
        "date_label",
        "date_precision",
        "year_start",
        "year_end"
      ],
      "precision_values": [
        "day",
        "month",
        "year",
        "range",
        "approximate_year",
        "approximate_period",
        "undated"
      ],
      "render_rule": "Only date_label is user-facing; sorting years cannot invent month/day.",
      "normalization_note_ko": "원본 approximate_year(예: 1402년경)는 approximate_period로 뭉개지 않고 별도 날짜 정밀도로 보존한다."
    },
    "evidence": {
      "source_ids_required_for_claims": true,
      "access_tiers": [
        "T1",
        "T2",
        "T3",
        "S1",
        "S2",
        "HOLD"
      ],
      "distinct_axes": [
        "historical_certainty",
        "text_access_tier",
        "editorial_review_status",
        "publication_permission"
      ]
    },
    "media": {
      "rights_status_required": true,
      "alt_ko_required": true,
      "disclosure_required_for_ai": true,
      "staged_file_not_present_in_git": true,
      "safe_to_display_requires_human_approval": true
    },
    "link_semantics": [
      "textual_influence",
      "later_reception",
      "movement_origin",
      "associated_place",
      "grounded_in",
      "claim_about",
      "imagines",
      "based_on"
    ],
    "relationship_guard": "Neither influence nor later reception implies direct personal contact, physical travel or doctrinal identity."
  },
  "read_paths": {
    "timeline": "event records with explicit date_precision and source_ids; no fabricated dates",
    "people": "PER global ID to events and claims",
    "geography": "WGS84 modern reference coordinate separate from medieval historical site assertion",
    "ideas": "theological-axis notes with evidence and competing views",
    "documents": "original text, print edition, translation/transcription and academic commentary are distinct witnesses"
  },
