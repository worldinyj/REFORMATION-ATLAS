      "proof": "MODERN_SCHOLARLY_ARGUMENT_IN_OPEN_PREVIEW",
      "scope": "Historical editorial history; not direct 1530 autograph comparison"
    },
    {
      "id": "V338-C02",
      "assertion": "Early 1531 Latin printing production included sheet cancellation and press corrections; different surviving exemplar states may matter",
      "source_id": "V338-S03",
      "print_page": 11,
      "proof": "MODERN_SCHOLARLY_ARGUMENT_IN_OPEN_PREVIEW",
      "scope": "No press-correction locus at CA IV VII VIII independently verified"
    },
    {
      "id": "V338-C03",
      "assertion": "Stegmann provisionally agrees with Bindseil that one Latin and one German quarto edition appeared in 1531; different VD16 numbers alone do not establish separately typeset editions",
      "source_id": "V338-S03",
      "print_page": 11,
      "proof": "MODERN_SCHOLARLY_ARGUMENT_WITH_EXPLICIT_QUALIFICATION",
      "scope": "Author notes comprehensive exemplar collation still needed"
    },
    {
      "id": "V338-C04",
      "assertion": "Specific 1531 Latin surviving Bamberg copy indexed as VD16 C 4734 and digitized by BSB/MDZ (288 scans)",
