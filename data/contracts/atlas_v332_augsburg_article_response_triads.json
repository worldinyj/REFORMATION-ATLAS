  "triads": [
    {
      "id": "V332-T1",
      "article": "IV",
      "topic": "JUSTIFICATION",
      "source_ids": [
        "V332-S-AC04",
        "V332-S-CF04",
        "V332-S-AP04"
      ],
      "classification": "PARTIAL_ACCEPTANCE_AND_DIFFERENCE",
      "shared": "가톨릭 측도 신적 은총 없는 자력구원은 부정한다.",
      "tension": "그리스도를 믿어 죄 사함을 받는다는 주장과 은총으로 행한 선행의 공로가 칭의에 미치는 의미가 충돌한다.",
      "response": "변증서는 그리스도의 공로와 약속을 믿음으로 받는 죄 사함을 강조하고 선행은 뒤따르나 칭의의 대가는 아니라고 설명한다.",
      "confession_locator": "AC IV [1-3]",
      "confutation_locator": "Confutation IV",
      "apology_locator": "Apology IV (II) [40-53,73-85]",
      "original_contemporary_language_text_checked": false
    },
    {
      "id": "V332-T2",
      "article": "VII",
      "topic": "CHURCH_DEFINITION",
      "source_ids": [
        "V332-S-AC07",
        "V332-S-CF07",
        "V332-S-AP0708"
      ],
      "classification": "CONDITIONAL_REJECTION_WITH_LIMITED_AGREEMENT",
      "shared": "가톨릭 응답도 교회가 지속된다는 믿음과 일부 의식의 지역적 차이를 인정한다.",
      "tension": "성도들의 모임이라는 정의가 죄인·위선자를 보이는 교회에서 배제하는지, 보편 의식을 어디까지 일치시켜야 하는지가 논쟁이다.",
      "response": "변증서는 영적 교회와 외적인 말씀·성례 공동체를 구별해 악인이 교회 조직에 섞여 있음을 인정한다.",
      "confession_locator": "AC VII [1-4]",
      "confutation_locator": "Confutation VII",
      "apology_locator": "Apology VII/VIII (IV) [2-20]",
      "original_contemporary_language_text_checked": false
    },
    {
      "id": "V332-T3",
      "article": "VIII",
      "topic": "UNWORTHY_MINISTER_AND_SACRAMENT_VALIDITY",
      "source_ids": [
        "V332-S-AC08",
        "V332-S-CF08",
        "V332-S-AP0708"
      ],
      "classification": "EXPLICIT_CONFUTATION_ACCEPTANCE",
      "shared": "가톨릭 반박문이 악한 성직자의 집례 때문에 성례의 효력이 무효화되지 않는다는 제8조를 명시적으로 수용한다.",
      "tension": "반박의 대상은 제8조의 성례 효력 자체가 아니라 제7조의 교회 정의를 오해한 데서 발생한다.",
      "response": "변증서는 제7조와 제8조의 관계를 설명하고 외적인 공동체에서 악한 이들이 섞여 있어도 성례는 유효하다고 해명한다.",
      "confession_locator": "AC VIII [1-3]",
      "confutation_locator": "Confutation VIII",
      "apology_locator": "Apology VII/VIII (IV) [2-20]",
      "original_contemporary_language_text_checked": false
    },
    {
      "id": "V332-T4",
      "article": "XXI",
      "topic": "SAINTS_REMEMBRANCE_INVOCATION",
      "source_ids": [
        "V332-S-AC21",
        "V332-S-CF21",
        "V332-S-AP21"
      ],
      "classification": "SHARED_EXAMPLE_DIFFERENT_INVOCATION",
      "shared": "양측은 성인들의 믿음과 선행을 기억하고 모범으로 삼는 것에 일정한 접점이 있다.",
      "tension": "사망한 성인에게 도움을 청하는 행위를 명령·약속·기도의 정당한 대상으로 볼 것인지가 다르다.",
      "response": "변증서는 감사·믿음의 격려·모방의 세 형태의 공경을 설명하면서 성인 호출을 규범으로 요구하는 일을 반대한다.",
      "confession_locator": "AC XXI [1-4]",
      "confutation_locator": "Confutation XXI",
      "apology_locator": "Apology XXI (IX) [1-10]",
      "original_contemporary_language_text_checked": false
    },
    {
      "id": "V332-T5",
      "article": "XXIV",
      "topic": "MASS_AND_SACRIFICE",
      "source_ids": [
        "V332-S-AC24",
        "V332-S-CF24",
        "V332-S-AP24"
      ],
      "classification": "MASS_RETAINED_DISPUTE_OVER_PRIVATE_MASS",
      "shared": "양측 모두 예배와 성찬 행위를 중요하게 다루며 루터파는 실제로 미사를 계속한다고 명시했다.",
      "tension": "사적 미사의 폐지, 라틴어·독일어 사용, 희생 제사 이해와 외적 행위의 효력 및 공로 적용이 충돌한다.",
      "response": "변증서는 미사를 계속 거행한다고 밝히되 단순한 외적 행위 자체가 타인의 죄 용서에 효력을 제공한다는 주장을 배격한다.",
      "confession_locator": "AC XXIV [1-11]",
      "confutation_locator": "Confutation XXIV",
      "apology_locator": "Apology XXIV (XII) [1-13]",
      "original_contemporary_language_text_checked": false
    }
  ],
