{
  "schema_version": "0.1",
  "contract_id": "VOL04-DOCUMENT-DETAIL-EDITION-COMPARISON",
  "status": "DESIGN_ONLY",
  "public_projection_generated": false,
  "compatibility": {
    "global_contract": "data/contracts/atlas_contract_v01.json",
