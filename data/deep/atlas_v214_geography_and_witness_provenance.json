  "places": [
    {
      "id": "PLACE-V214-KOZI",
      "name": "Kozí hrádek",
      "display_ko": "코지 흐라데크",
      "modern_country": "Czech Republic",
      "lat": 49.3898372,
      "lon": 14.7229983,
      "coordinate_precision": "HISTORIC_SITE_COORD_FROM_HERITAGE_WEBSITE",
      "place_essay_ko": "후스가 1413년 집필 활동을 한 코지 흐라데크 성터다. 오늘날 보이는 유적의 안내 좌표와 15세기 저술의 정확한 필사 위치는 다르다. 프라하 국립도서관 IV H 19의 소장 주소를 이 장소로 옮기지 않는다.",
      "source_ids": [
        "SRC-V214-KOZI",
        "SRC-V214-HUS-CASTLE"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": true
    },
    {
      "id": "PLACE-V214-KONSTANZ",
      "name": "Konstanz",
      "display_ko": "콘스탄츠",
      "modern_country": "Germany",
      "lat": 47.663,
      "lon": 9.176,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1415년 후스의 심리와 처형이 있었던 도시다. 후센슈타인과 같은 후대 기념물의 설치 지점은 처형 장소를 재현하려는 기억의 장소이지 1415년 정확한 현장 좌표라고 단정하지 않는다.",
      "source_ids": [
        "SRC-V214-HUS-CONST"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-WITTENBERG",
      "name": "Lutherstadt Wittenberg",
      "display_ko": "비텐베르크",
      "modern_country": "Germany",
      "lat": 51.868,
      "lon": 12.648,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1517년의 루터 논제와 1531년 아우크스부르크 승인 인쇄판의 배경 도시는 비텐베르크다. 학술 논제의 성문 게시 행동 자체는 논쟁의 대상이므로 성당 문에 직접 핀을 고정하지 않는다. 1530년 문서 제출은 아우크스부르크에서 벌어졌다.",
      "source_ids": [
        "SRC-V214-WITT",
        "SRC-V214-AUGSBURG"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-WORMS",
      "name": "Worms",
      "display_ko": "보름스",
      "modern_country": "Germany",
      "lat": 49.63,
      "lon": 8.36,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1521년 루터 심문과 제국 칙령의 정치적 장소다. 디지털 비평판은 5월 8일 문안과 26일 서명·공표의 단계 차이를 다룬다. 도시 중심 좌표는 황제의 서명 장소나 심문 당시 특정 방을 보장하지 않는다.",
      "source_ids": [
        "SRC-V214-WORMS"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-ZURICH",
      "name": "Zürich",
      "display_ko": "취리히",
      "modern_country": "Switzerland",
      "lat": 47.376,
      "lon": 8.542,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1523년 두 차례 종교 논쟁과 시의회 개혁이 이루어진 도시다. 1527년 펠릭스 만츠의 익사형 판결은 주립문서관 B VI 251에 남았으며 현대 비평 전사에서 원어 표현을 확인할 수 있다. 문서 소장처·도시 중심·리마트강 처형 지점을 각각 구분한다.",
      "source_ids": [
        "SRC-V214-ZURICH",
        "SRC-V214-MANZ-CATALOG",
        "SRC-V214-MANZ-TRANS"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-MARBURG",
      "name": "Marburg",
      "display_ko": "마르부르크",
      "modern_country": "Germany",
      "lat": 50.811,
      "lon": 8.77,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1529년 루터와 츠빙글리 진영의 대화와 합의문이 작성된 도시다. 합의문 제15조의 성만찬 이견과 상호 사랑 약속을 함께 설명해야 한다. 후대 편집 문서에 적힌 10월 3일과 일부 서지 기록의 3·4일 표현 차이는 별도 대조가 필요하다.",
      "source_ids": [
        "SRC-V214-MARBURG"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-AUGSBURG",
      "name": "Augsburg",
      "display_ko": "아우크스부르크",
      "modern_country": "Germany",
      "lat": 48.371,
      "lon": 10.898,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1530년 6월 25일 신앙고백이 제국의회에 제출된 도시다. 주교 궁전 건물 관련 역사 기록은 있어도 도시 중심 핀이 실제 문서 낭독 방의 위치를 뜻하지는 않는다. 이듬해 공인 인쇄본은 비텐베르크와 연결된다.",
      "source_ids": [
        "SRC-V214-AUGSBURG"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-BASEL",
      "name": "Basel",
      "display_ko": "바젤",
      "modern_country": "Switzerland",
      "lat": 47.56,
      "lon": 7.589,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "칼뱅의 『기독교강요』 1536년 라틴어 초판이 나온 인쇄 도시다. 프랑수아 1세에게 보내는 헌사 작성일이나 칼뱅이 머문 정확한 인쇄소 주소를 이 도시 좌표로 자동 확정하지 않는다.",
      "source_ids": [
        "SRC-V214-BASEL"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-STRASBOURG",
      "name": "Strasbourg",
      "display_ko": "스트라스부르",
      "modern_country": "France",
      "lat": 48.583,
      "lon": 7.752,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1539년 칼뱅 『기독교강요』 라틴어 확대판의 인쇄 도시다. 1536년 바젤 초판에서 1559년 제네바 최종판에 이르는 판본 변화를 설명할 때 스트라스부르를 단순한 여행 경유지가 아니라 새 문헌을 제작하고 유통한 도시로 표시해야 한다. 현대 소장 도서관의 주소나 후대 비평판 인쇄사의 다른 도시를 1539년의 실제 인쇄지로 바꿔서는 안 되며, 당시 인쇄소 건물의 정확한 좌표도 확인되지 않았다.",
      "source_ids": [
        "SRC-V214-STRASBOURG"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-GENEVA",
      "name": "Genève",
      "display_ko": "제네바",
      "modern_country": "Switzerland",
      "lat": 46.204,
      "lon": 6.144,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1559년 칼뱅 『기독교강요』 최종 라틴어판과 1560년 프랑스어판의 인쇄 도시다. 1560년 장 크레스팽 인쇄본의 현존 소장처는 투르로 확인되므로 제네바의 인쇄지와 프랑스 소장 기관을 별개 객체로 기록한다.",
      "source_ids": [
        "SRC-V214-GENEVA-1559",
        "SRC-V214-GENEVA-1560"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    },
    {
      "id": "PLACE-V214-TRENTO",
      "name": "Trento",
      "display_ko": "트렌토",
      "modern_country": "Italy",
      "lat": 46.067,
      "lon": 11.122,
      "coordinate_precision": "MODERN_CITY_CENTROID_APPROXIMATE",
      "place_essay_ko": "1545년 공의회 개회, 1547년 제6회기 의롭다 함 교령, 1563년 제23회기 신학교 규정의 도시다. 도시 중심부를 세 회의의 특정 좌석 위치로 제시하지 않으며, 각 교구의 규정 시행 장소와 분리한다.",
      "source_ids": [
        "SRC-V214-TRENT"
      ],
      "site_building_or_room_verified": false,
      "historian_approved": false,
      "can_publish": false,
      "site_footprint_location_documented": false
    }
  ],
