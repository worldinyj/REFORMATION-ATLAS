  "claims": [
    {
      "id": "CLM-V04-ME-001",
      "statement_ko": "1497년 브레텐 출생 멜란히톤은 그리스어와 인문주의 학문을 배경으로 1518년 비텐베르크 대학에 부임했다.",
      "source_ids": [
        "SRC-V04-ME-001",
        "SRC-V04-ME-002",
        "SRC-V04-ME-016"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ME-002",
      "statement_ko": "1518년 취임 연설의 정확한 날짜는 도시 안내(8월 28일)와 최근 논문(8월 29일)의 기술이 달라 원자료 확인 전 확정하지 않는다.",
      "source_ids": [
        "SRC-V04-ME-002",
        "SRC-V04-ME-003"
      ],
      "evidence_status": "DATE_CONFLICT_HOLD",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ME-003",
      "statement_ko": "인문주의의 언어·논리·고전 학문과 교육개혁은 멜란히톤의 핵심 기여이며 신학사뿐 아니라 학문사로 다뤄야 한다.",
      "source_ids": [
        "SRC-V04-ME-002",
        "SRC-V04-ME-016",
        "SRC-V04-ME-012"
      ],
      "evidence_status": "SUPPORTED_SYNTHESIS",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ME-004",
      "statement_ko": "1521년 『Loci communes』는 초기 루터파 신학 논의를 체계화한 중요한 책이지만 여러 차례 개정됐으므로 모든 판본이 동일하지 않다.",
      "source_ids": [
        "SRC-V04-ME-013",
        "SRC-V04-ME-017",
        "SRC-V04-ME-015"
      ],
      "evidence_status": "SUPPORTED_VERSIONS_NEED_WITNESS_COMPARISON",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ME-005",
      "statement_ko": "루터와 멜란히톤은 서로의 성경·언어 연구와 신학 작업을 도왔지만 루터 저술 전부를 멜란히톤이 공동 집필한 것으로 확대하면 안 된다.",
      "source_ids": [
        "SRC-V04-ME-017",
        "SRC-V04-ME-001"
      ],
      "evidence_status": "SUPPORTED_INTERPRETATION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ME-006",
      "statement_ko": "1528년 무렵 작센 교회 시찰과 학교·대학 개혁은 멜란히톤의 신학과 도시·영방 정치의 결합을 보여준다.",
      "source_ids": [
        "SRC-V04-ME-009",
        "SRC-V04-ME-012",
        "SRC-V04-ME-002"
      ],
      "evidence_status": "SUPPORTED_WITH_DETAILS_PENDING",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ME-007",
      "statement_ko": "1530년 6월 25일 아우크스부르크에서 제출·낭독된 신앙고백의 주요 문안 작성자는 멜란히톤이며 개인 작품이 아닌 영방·도시 대표들의 공적 문서다.",
      "source_ids": [
        "SRC-V04-ME-001",
