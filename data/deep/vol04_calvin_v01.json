  "claims": [
    {
      "id": "CLM-V04-CA-001",
      "statement_ko": "1509년 누아용에서 태어난 칼뱅은 프랑스 인문주의·법학 교육을 경험했고 회심의 정확한 시점은 논쟁적이다.",
      "source_ids": [
        "SRC-V04-CA-001",
        "SRC-V04-CA-011"
      ],
      "evidence_status": "SUPPORTED_WITH_DATE_CAUTION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-002",
      "statement_ko": "1536년 바젤 라틴어 『기독교강요』 초판은 6장 체제이고, 1559년 라틴어 최종판은 네 권 80장 체제로 재구성되었다.",
      "source_ids": [
        "SRC-V04-CA-004",
        "SRC-V04-CA-005",
        "SRC-V04-CA-014"
      ],
      "evidence_status": "SUPPORTED_EDITION_DISTINCTION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-003",
      "statement_ko": "1541년 첫 프랑스어판과 1560년 후대 프랑스어판을 하나의 동일 원문처럼 취급하면 안 된다.",
      "source_ids": [
        "SRC-V04-CA-001",
        "SRC-V04-CA-005",
        "SRC-V04-CA-014"
      ],
      "evidence_status": "SUPPORTED_EDITION_DISTINCTION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-004",
      "statement_ko": "칼뱅은 1536년 파렐의 요청으로 제네바 개혁에 합류했으나 1538년에 추방됐고 1541년 귀환했다.",
      "source_ids": [
        "SRC-V04-CA-001",
        "SRC-V04-CA-011",
        "SRC-V04-CA-016"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-005",
      "statement_ko": "1538–1541년 슈트라스부르의 목회와 마르틴 부처와의 교류는 칼뱅의 예배와 교회제도 생각에 영향을 미쳤다.",
      "source_ids": [
        "SRC-V04-CA-001",
        "SRC-V04-CA-016"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-006",
      "statement_ko": "1541년 제네바 교회규정은 목사·교사·장로·집사의 네 직분 및 목사회·당회를 제도화했다.",
      "source_ids": [
        "SRC-V04-CA-002",
        "SRC-V04-CA-003"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-007",
      "statement_ko": "제네바 제도에서 시의회와 교회 당회가 권력을 나누고 다퉜으므로 '칼뱅의 절대 신정독재'도 '근대 정교분리'도 과도한 단순화이다.",
      "source_ids": [
        "SRC-V04-CA-002",
        "SRC-V04-CA-003"
      ],
      "evidence_status": "INTERPRETIVE_WITH_PERSPECTIVES",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-008",
      "statement_ko": "칼뱅의 예정·섭리·칭의·그리스도인의 삶 등 신학을 하나의 후대 '칼뱅주의 5대 교리'로만 환원하면 저작의 시대별 발전이 가려진다.",
      "source_ids": [
        "SRC-V04-CA-004",
        "SRC-V04-CA-005"
      ],
      "evidence_status": "EDITORIAL_SYNTHESIS",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-009",
      "statement_ko": "칼뱅은 루터의 성찬 현존 강조와 츠빙글리의 해석을 단순히 중간값으로 택한 것이 아니라 성령과 그리스도와의 영적 교제 문제를 독자적으로 설명했다.",
      "source_ids": [
        "SRC-V04-CA-001",
        "SRC-V04-CA-006",
        "SRC-V04-CA-007",
        "SRC-V04-CA-008"
      ],
      "evidence_status": "COMPARATIVE_INTERPRETATION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-010",
      "statement_ko": "1549년 칼뱅과 불링거의 취리히 합의는 협상의 결과이며 그 성찬 조항에 대한 루터파 해석과 개혁파 해석이 다르다.",
      "source_ids": [
        "SRC-V04-CA-006",
        "SRC-V04-CA-007",
        "SRC-V04-CA-008"
      ],
      "evidence_status": "SUPPORTED_CONTESTED_RECEPTION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-011",
      "statement_ko": "1553년 세르베투스가 제네바에서 이단 혐의로 처형된 것은 종교 강제와 양심의 자유를 검토해야 할 중대한 사건이다.",
      "source_ids": [
        "SRC-V04-CA-009",
        "SRC-V04-CA-010"
      ],
      "evidence_status": "SUPPORTED_SENSITIVE",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-012",
      "statement_ko": "세르베투스의 재판은 제네바 시당국의 사법권과 칼뱅의 신학적 논박·개입을 구별해야 하며 '칼뱅 혼자 판결' 혹은 '칼뱅 무관' 양쪽을 피한다.",
      "source_ids": [
        "SRC-V04-CA-009",
        "SRC-V04-CA-010",
        "SRC-V04-CA-002"
      ],
      "evidence_status": "SCHOLARLY_DEBATE",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-013",
      "statement_ko": "세르베투스 처형을 비판한 세바스티안 카스텔리오는 동일 시대에도 강제 처형을 반대하는 신학적 견해가 있었음을 보여준다.",
      "source_ids": [
        "SRC-V04-CA-009"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-014",
      "statement_ko": "1559년 제네바 아카데미 개교는 칼뱅이 추진한 신학과 인문주의 교육 체계를 제도화한 사건이다.",
      "source_ids": [
        "SRC-V04-CA-012",
        "SRC-V04-CA-014"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-015",
      "statement_ko": "칼뱅과 멜란히톤은 인문주의와 개혁의 공통 문제를 논의하고 교류했으나 양자의 교리를 완전 동일시할 근거는 아니다.",
      "source_ids": [
        "SRC-V04-CA-013"
      ],
      "evidence_status": "SUPPORTED_WITH_SCOPE",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-CA-016",
      "statement_ko": "칼뱅은 1564년 5월 27일 제네바에서 사망했으며, 후대 제네바 신학 유산은 동시대의 정치·인쇄·교육 네트워크를 통해 확산되었다.",
      "source_ids": [
        "SRC-V04-CA-001",
        "SRC-V04-CA-012",
        "SRC-V04-CA-014"
      ],
      "evidence_status": "SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    }
  ],
