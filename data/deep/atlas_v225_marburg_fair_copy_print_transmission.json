  "claims": [
    {
      "id": "CLM-V225-03",
      "summary_ko": "합의문의 표제와 취리히 인쇄본은 10월 3일을 표기한다.",
      "source_ids": [
        "SRC-V225-ERARA-SEARCH",
        "SRC-V225-MBW825",
        "SRC-V225-Z-CAT"
      ],
      "date": "1529-10-03",
      "certainty": "EDITORIAL_AND_CATALOGUE_TEXT"
    },
    {
      "id": "CLM-V225-04",
      "summary_ko": "DigiRef 해설은 정서본 3부가 10월 4일 만들어졌고 2부가 현존한다고 설명한다.",
      "source_ids": [
        "SRC-V225-DIGIREF"
      ],
      "date": "1529-10-04",
      "certainty": "SECONDARY_CRITICAL_COMMENTARY"
    },
    {
      "id": "CLM-V225-Z-LEAF",
      "summary_ko": "취리히 Z에는 헤센 K에 없는 추가 잎이 있고, 취리히 문서관은 7·13·15조의 3개 추가를 기술한다. 이들이 동일한 면의 동일한 추가 구절인지 아직 직접 확인되지 않았다.",
      "source_ids": [
        "SRC-V225-DIGIREF",
        "SRC-V225-Z-CAT"
      ],
      "date": null,
      "certainty": "TWO_CATALOGUED_FACTS_NOT_FOLIO_COLLATED"
    },
    {
      "id": "CLM-V225-SIGN",
      "summary_ko": "DigiRef는 K에서 비텐베르크 측이 먼저 서명하고 Z에서는 마지막에 있던 그룹이 먼저 나온다고 설명한다.",
      "source_ids": [
        "SRC-V225-DIGIREF"
      ],
      "date": "1529-10-04",
      "certainty": "SCHOLARLY_COMMENTARY_NOT_IMAGE_READ"
    },
    {
      "id": "CLM-V225-PRINT",
      "summary_ko": "DigiRef에 따르면 마르부르크의 프란츠 로데가 정서본 제작 다음날 인쇄했고, 츠빙글리 귀환 후 취리히 인쇄, 1530년 아우크스부르크 오지안더 인쇄가 뒤따랐다.",
      "source_ids": [
        "SRC-V225-DIGIREF"
      ],
      "date": null,
      "certainty": "SCHOLARLY_COMMENTARY"
    },
    {
      "id": "CLM-V225-21",
      "summary_ko": "마르부르크 인쇄본이 21차례 재인쇄되었다는 수치는 DigiRef의 학술 해설에 따른 보고이며, 독립 판본 목록 대조가 필요하다.",
      "source_ids": [
        "SRC-V225-DIGIREF"
      ],
      "date": null,
      "certainty": "SINGLE_SCHOLARLY_SOURCE_COUNT"
    },
    {
      "id": "CLM-V225-PRINT2",
      "summary_ko": "e-rara는 1529년 취리히 관련 별도 소장본 두 종을 검색 결과로 표시한다. 5.174,5는 W2119로 확인되었으나 Zwingli MvK A81,8을 W2118이라고 확정할 개별 상세서지는 미확인이다.",
      "source_ids": [
        "SRC-V225-ERARA-SEARCH",
        "SRC-V225-ERARA-W2119"
      ],
      "date": "1529",
      "certainty": "EXEMPLAR_RECORDS_MAPPED_PARTIAL"
    }
