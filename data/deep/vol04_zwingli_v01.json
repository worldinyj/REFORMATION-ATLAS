  "claims": [
    {
      "id": "CLM-V04-ZW-001",
      "statement_ko": "1519년 1월 1일 츠빙글리는 취리히 그로스뮌스터에서 설교 사역을 시작했다.",
      "source_ids": [
        "SRC-V04-ZW-001"
      ],
      "confidence": "DIRECT_INSTITUTIONAL_CHRONOLOGY",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-002",
      "statement_ko": "1522년 사순절 소시지 사건에서 츠빙글리는 참석했지만 실제로 소시지를 먹었다고 단정하면 안 되며, 금식 규정 문제를 신학적으로 변호했다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-011"
      ],
      "confidence": "CROSS_SOURCE_SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-003",
      "statement_ko": "1523년 취리히 첫 공개 신학 논쟁에서 성경의 권위와 개혁이 쟁점이 됐으며 도시 의회가 제도 개혁에 관여했다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-002",
        "SRC-V04-ZW-003"
      ],
      "confidence": "CROSS_SOURCE_SUPPORTED",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-004",
      "statement_ko": "1523년 67개 조항에 관한 Emory 서지의 1월 27일 표현과 취리히 중앙도서관의 첫 논쟁일 1월 29일은 동일한 사건의 정확 날짜로 자동 병합할 수 없다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-003"
      ],
      "confidence": "SOURCE_DATE_CONFLICT_HOLD",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-005",
      "statement_ko": "츠빙글리 개혁은 성직자 개인의 신학 변화뿐 아니라 취리히 시 의회의 정치적 결정과 예배/시각물/금식 규정 변경을 포함한다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-002"
      ],
      "confidence": "SUPPORTED_SYNTHESIS",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-006",
      "statement_ko": "1525년 취리히 재세례파의 성인 신자세례 주장과 도시 교회 제도 갈등이 심화됐고, 1527년 펠릭스 만츠가 시의회 결정으로 처형됐다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-007"
      ],
      "confidence": "SUPPORTED_WITH_ETHICAL_CONTEXT",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-007",
      "statement_ko": "재세례파의 강압적 박해는 예배 자유의 역사에서 다뤄야 할 문제이며 츠빙글리 개혁의 긍정적 성과로만 설명하면 안 된다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-007"
      ],
      "confidence": "EDITORIAL_EVALUATION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-008",
      "statement_ko": "츠빙글리의 성찬 신학은 루터의 실제 현존 강조와 달랐으나 '성찬을 아무 의미 없는 기념으로 여겼다'는 단순화는 부적절하다.",
      "source_ids": [
        "SRC-V04-ZW-002",
        "SRC-V04-ZW-004",
        "SRC-V04-ZW-005",
        "SRC-V04-ZW-006"
      ],
      "confidence": "COMPARTIVE_INTERPRETATION",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-009",
      "statement_ko": "1529년 마르부르크 회담은 완전한 신학적 일치에 도달하지 못했으며, 양측 보고는 편향된 목격자의 해석을 반영한다.",
      "source_ids": [
        "SRC-V04-ZW-004",
        "SRC-V04-ZW-005",
        "SRC-V04-ZW-006"
      ],
      "confidence": "TWO_SIDED_PRIMARY_REPORTS",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-010",
      "statement_ko": "1529년 첫 카펠 갈등과 1531년 두 번째 카펠 전쟁은 다른 사건으로, 1531년 10월 11일 전투에서 츠빙글리가 사망했다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-008",
        "SRC-V04-ZW-009"
      ],
      "confidence": "MUSEUM_CROSSCHECK",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-011",
      "statement_ko": "취리히의 개혁은 종교문제만이 아니라 용병제 반대와 도시 간 동맹 및 구 스위스 연방의 정치적 갈등을 동반했다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-002",
        "SRC-V04-ZW-009",
        "SRC-V04-ZW-010"
      ],
      "confidence": "SYNTHESIS",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-012",
      "statement_ko": "1531년 이후 츠빙글리 유산은 하인리히 불링거 등 후임자의 제도와 문헌을 통해 이어졌으며 칼뱅의 후대 입장으로 소급하면 안 된다.",
      "source_ids": [
        "SRC-V04-ZW-001",
        "SRC-V04-ZW-002"
      ],
      "confidence": "FOLLOWUP_COMPARATIVE_REVIEW",
      "review_status": "DRAFT",
      "approved": false,
      "publication_approved": false
    },
    {
      "id": "CLM-V04-ZW-013",
      "statement_ko": "인쇄물 서지·당대 목격자 번역·1605년 불링거 삽화·19세기 역사화는 서로 다른 역사적 증거 층위에 속한다.",
      "source_ids": [
