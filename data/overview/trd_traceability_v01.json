  "contracts": {
    "canonical_id": {
      "people": "stable canonical person ID (prefer existing PER for matched 3)",
      "relationship": "typed OV-R references resolved through alias mapping",
      "deep": "same entity ID, separate content depth block",
      "no_silent_rewrite": true
    },
    "evidence": {
      "source_id_required": true,
      "access_class_required": true,
      "rights_separate": true,
      "editorial_status_separate": true
    },
    "publish": {
      "required_flags": [
        "editorial_approved",
        "rights_cleared_if_media",
        "publication_approved"
      ],
      "draft_in_public": false,
      "deny_by_default": true,
      "preview": "local-only or verified authenticated access; robots noindex alone insufficient"
    },
    "date": {
      "display_from": "date_label",
      "sort_from": "year_start",
      "precision_preserved": true,
      "approximate_day_invention_forbidden": true
    },
    "geo": {
      "place_name_can_render": true,
      "coordinates_allowed_only_when": "source-linked_and_human_verified",
      "currently_verified_count": 0,
      "disable_map_initially": true
    }
  },
