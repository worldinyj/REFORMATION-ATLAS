  "arcs": [
    {
      "id": "ARC412-01",
      "title": "신앙고백 이후의 질문: 경건주의는 무엇을 바꾸려 했나",
      "date_scope": "1660~1710년",
      "region_ids": [
        "R412-01"
      ],
      "source_ids": [
        "S412-01",
        "S412-02"
      ],
      "intro": "전쟁과 종교적 경계가 굳어진 유럽에서 루터파 안의 목회자·평신도들은 신앙고백의 바른 표현을 넘어서 성경 읽기, 작은 모임, 이웃 사랑과 공동체 교육을 강조했다.",
      "story": "슈페너의 1675년 『경건한 열망』은 평신도의 성경 모임과 일상의 경건을 통해 교회 안에서부터 갱신을 일으킬 수 있다고 제안했다. 이는 루터의 개혁을 부정하고 완전히 다른 교회를 세우자는 주장만이 아니라 기존 교회가 신앙의 삶을 충분히 반영하는가라는 내부 질문이었다. 경건주의 안에는 제도 안의 쇄신과 분리적 경향 등 다른 입장도 함께 존재했다.",
      "counterpoint": "경건주의를 신학 없는 감정운동이나 모든 국가교회의 즉각적 분리로 묘사하지 않는다.",
      "link_to_previous": [
        "A409-05"
      ]
    },
    {
      "id": "ARC412-02",
      "title": "경건을 교육과 번역으로: 할레와 남인도의 연결",
      "date_scope": "1695~1730년대",
      "region_ids": [
        "R412-01",
        "R412-03"
      ],
      "source_ids": [
        "S412-02",
        "S412-03",
        "S412-04",
        "S412-05"
      ],
      "intro": "프랑케가 1695년 할레에서 시작한 가난한 아이들을 위한 교육은 학교·자선·인쇄와 같은 제도를 통해 경건을 실천하려는 운동으로 확장됐다.",
      "story": "1706년 덴마크 왕실과 할레의 연결을 바탕으로 지겐발크와 플뤼차우가 남인도 트랑케바르에 도착했다. 이들은 타밀어를 배워 현지인과 소통하고 현지 통역·언어 협력자들과 함께 교육·번역을 추진했다. 할레의 동유럽·헝가리 네트워크도 보여 주듯, 경건주의의 영향은 독일의 한 도시와 인도의 한 선교 거점 사이의 일방통행만으로 설명되지 않는다.",
      "counterpoint": "유럽인 한 사람이 타밀어를 완성해 전한 것처럼 쓰지 않는다. 남인도의 기독교가 1706년 처음 생겼다는 주장도 금지한다.",
      "link_to_previous": [
        "A409-06",
        "A410-02"
      ]
    },
    {
      "id": "ARC412-03",
      "title": "모라비아 공동체: 피난·연대·해외 선교의 다른 길",
      "date_scope": "1722~1760년대",
      "region_ids": [
        "R412-02",
        "R412-06"
      ],
      "source_ids": [
        "S412-06",
        "S412-07"
      ],
      "intro": "1722년 작센 헤른후트에 모인 모라비아 출신 피난민과 여러 신자들은 신앙 공동체와 세계적 네트워크를 새롭게 조직했다.",
      "story": "1727년 이후 공동체 갱신과 교류가 확산되었고, 1732년에는 카리브해 세인트토머스의 노예화된 주민들을 향한 모라비아 선교가 시작됐다. 이 역사는 할레 경건주의의 단순한 지부가 아니다. 두 흐름은 같은 시대의 신앙적 관심을 공유하면서도 전도 방식·조직·신학적 강조점에서 논쟁했다. 식민지에서 노예화된 신자들이 경험한 권력 관계 역시 별도로 다뤄야 한다.",
      "counterpoint": "헤른후트·할레·모라비아 공동체를 하나의 기관으로 합치거나, 모라비아의 모든 활동을 노예제에 대한 완전한 저항으로 미화하지 않는다.",
      "link_to_previous": [
        "A409-06",
        "A410-04"
      ]
    },
    {
      "id": "ARC412-04",
      "title": "웨일스·잉글랜드·북미: 하나가 아니었던 여러 부흥",
      "date_scope": "1730~1770년대",
      "region_ids": [
        "R412-04",
        "R412-05"
      ],
      "source_ids": [
        "S412-08",
        "S412-09",
        "S412-10",
        "S412-11"
      ],
      "intro": "18세기 영어권의 부흥은 순회설교와 야외예배, 성경 모임과 회개·회심의 경험을 강조했지만 하나의 교파가 만든 통일 운동이 아니었다.",
      "story": "웨일스의 하웰 해리스와 대니얼 롤런드, 조지 휫필드, 존·찰스 웨슬리는 서로 연락하고 영향을 주고받으면서도 예정과 은총, 교회의 조직에 관해 다른 길을 택했다. 웨일스의 칼뱅주의적 감리교와 웨슬리계 감리교를 구별해야 한다. 북아메리카의 1730~1740년대 대각성도 한 해에 시작하고 끝난 단일 집회가 아니라 여러 지역의 부흥을 나중에 묶어 부르는 역사적 범주다.",
      "counterpoint": "감리교는 존 웨슬리 한 사람만이 만든 운동이라고 하지 않는다. 북미 부흥을 곧 식민지 주민 전원의 동일한 변화로 해석하지 않는다.",
      "link_to_previous": [
        "A409-05"
      ]
    },
    {
      "id": "ARC412-05",
      "title": "부흥은 누구의 사회를 바꾸었나: 감리교·흑인교회·여성",
      "date_scope": "1740~1840년대",
      "region_ids": [
        "R412-04",
        "R412-05"
      ],
      "source_ids": [
        "S412-08",
        "S412-10",
        "S412-20",
        "S412-21"
      ],
      "intro": "부흥의 영향은 설교자의 일대기뿐 아니라 교회 모임·노동자의 교육·공동체 규율과 여성·흑인 신자들의 새로운 지도력에서 드러났다.",
      "story": "웨슬리계 감리교는 작은 모임과 예배·구제를 연결했고, 다른 감리교 전통은 신학과 지역적 기반에서 차이가 있었다. 미국의 흑인 그리스도인들은 차별적인 교회 제도에 대응해 자치 조직을 만들었으며, 1816년 아프리카감리교회(AME)의 조직은 그 상징적인 사례다. 자레나 리는 1820년대 설교와 1836년 회고록으로 흑인 여성의 신앙과 공적 발언권을 보여 준다. 그러나 부흥 지도자들이 모두 노예제에 같은 입장이었던 것은 아니다.",
      "counterpoint": "대각성을 곧 노예해방으로 직결하거나, 여성에게 모든 교회의 정식 성직 권한이 동일하게 주어졌다고 하지 않는다.",
      "link_to_previous": [
        "A410-04"
      ]
    },
    {
      "id": "ARC412-06",
      "title": "근대 선교단체와 세람포르: 인쇄·학교·현지 언어",
      "date_scope": "1792~1850년대",
      "region_ids": [
        "R412-03",
        "R412-07",
        "R412-04"
      ],
      "source_ids": [
        "S412-04",
        "S412-05",
        "S412-12",
        "S412-13"
      ],
      "intro": "18세기 말 영국과 유럽에서는 자발적 선교단체와 후원 네트워크가 조직되었다. 그러나 유럽의 단체 설립이 곧 그 지역 기독교의 시작은 아니다.",
      "story": "1792년 영국 침례교 선교회 설립과 1793년 윌리엄 캐리의 인도행, 1800년 세람포르 활동은 19세기 인쇄와 교육·번역의 중요한 전개다. 캐리와 동료들이 혼자 수십 개 언어의 성경을 완성한 것이 아니라 인도인 언어 학자와 번역 협력자들이 함께 작업했다. 1818년 세람포르 대학을 비롯한 교육은 신앙과 지역 사회의 지적 변화에도 얽혔다. 교역과 식민 행정의 제약·기회도 함께 보아야 한다.",
      "counterpoint": "윌리엄 캐리를 '세계 최초의 선교사'라고 부르거나 현지 언어 전문가의 이름과 공헌을 지우지 않는다.",
      "link_to_previous": [
        "A409-06",
        "A410-02"
      ]
    },
    {
      "id": "ARC412-07",
      "title": "가톨릭·동방정교의 별도 역사: 예수회와 알래스카",
      "date_scope": "1773~1850년대",
      "region_ids": [
        "R412-08",
        "R412-09"
      ],
      "source_ids": [
        "S412-14",
        "S412-15",
        "S412-16"
      ],
      "intro": "17~19세기 세계 기독교는 개신교의 경건주의·부흥·해외 선교만의 역사가 아니다. 가톨릭과 동방정교 공동체도 서로 다른 위기와 새로운 연결을 경험했다.",
      "story": "예수회는 1773년 세계적으로 억압됐다가 1814년에 복원되었다. 1794년 러시아 정교회의 선교사들이 알래스카 코디액에 도착했고, 러시아 모피무역과 원주민 사회의 접촉 속에서 종교가 확산했다. 동방정교 선교는 현지 언어를 배우고 신자들과 협력한 측면이 있지만, 식민 무역 회사의 폭력·노동 착취와도 복합적으로 얽혔다. 유럽에서 세계로 향하는 하나의 개신교 선교 화살표만으로 설명되지 않는다.",
      "counterpoint": "러시아 정교 선교를 식민 지배와 분리된 완전히 평화로운 역사로 미화하지 않는다. 예수회 복원이 모든 가톨릭 선교의 시작이라고 말하지 않는다.",
      "link_to_previous": [
        "A409-03",
        "A409-06",
        "A410-02"
      ]
    },
    {
      "id": "ARC412-08",
      "title": "19세기 현지인 지도자와 제국: 아프리카·태평양·한국의 다리",
      "date_scope": "1820~1900년",
      "region_ids": [
        "R412-06",
        "R412-08",
        "R412-10",
        "R412-11",
        "R412-12"
      ],
      "source_ids": [
        "S412-17",
        "S412-18",
        "S412-19",
        "S412-12",
        "S412-24",
        "S412-25",
        "S412-27"
      ],
      "intro": "19세기 선교를 유럽에서 해외로 나아간 이동 경로로만 읽으면 교회를 세우고 번역하며 이끄는 현지 사람들의 이름이 사라진다.",
      "story": "서아프리카의 사무엘 아자이 크라우더는 노예화와 해방, 교육·언어 연구를 거쳐 1864년 영국국교회 나이저 지역 주교가 됐다. 하지만 그의 아프리카인 주도 선교 정책은 훗날 일부 유럽 선교사들의 차별적 저항을 받았다. 하와이에서는 19세기 중반 하와이인 목회자들이 다른 태평양 섬까지 이동해 사역했다. 한국에서는 1880년대 해외 거점의 한국어 성경 번역과 한국인 신자의 활동이 외국인 상주 선교사들의 입국 전후로 진행됐다. 선교는 인쇄·교육·언어 교류와 함께 노예제·식민지 권력·인종적 위계를 통과한 역사였다.",
      "counterpoint": "아프리카인 주교와 태평양 현지인 목회자를 유럽 선교사의 조력자로만 줄이지 않는다. 한국 천주교는 이미 18세기 한국인 공동체를 형성했음을 잊지 않는다.",
      "link_to_previous": [
        "A410-03",
        "A410-04",
        "A410-06",
        "A410-08"
      ]
    }
  ],
