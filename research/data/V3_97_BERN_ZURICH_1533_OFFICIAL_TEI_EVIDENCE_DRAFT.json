  "claims": [
    {
      "id": "C397-01",
      "sources": [
        "HBBW3-219:s7",
        "HBBW3-219:s8"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "취리히는 부처와의 친교를 인정하나 루터와의 교리적 완전 합치는 승인하지 않는다",
      "scope": "THEOLOGICAL_DISAGREEMENT"
    },
    {
      "id": "C397-02",
      "sources": [
        "HBBW3-220:s3"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "부처는 취리히 목회자들의 협력 정신을 높이 평가한다",
      "scope": "BUCER_OWN_ASSESSMENT"
    },
    {
      "id": "C397-03",
      "sources": [
        "HBBW3-220:s25"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "부처는 레오 유트가 부탁한 메간더·할러 문제를 성실하게 처리하겠다고 약속한다",
      "scope": "MEDIATION_PROMISE"
    },
    {
      "id": "C397-04",
      "sources": [
        "HBBW3-221:s2",
        "HBBW3-221:s11",
        "HBBW3-221:s13"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "할러는 부처를 반기고 레오 유트를 통한 동료 목회자와의 화해 가능성을 서술한다",
      "scope": "HALLER_EARLY_RECEPTION"
    },
    {
      "id": "C397-05",
      "sources": [
        "HBBW3-228:s2"
      ],
      "grade": "DIRECT_EDITED_TEXT_SINGLE_REPORT",
      "thesis_ko": "베른에서 부처와 함께 120명이 모였다는 수치는 할러 자신의 보고에만 직접 근거한다",
      "scope": "PARTICIPATION_COUNT",
      "reported_participants": 120,
      "independent_count_verified": false
    },
    {
      "id": "C397-06",
      "sources": [
        "HBBW3-228:s3"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "모임의 논의 주제에 율법, 성찬, 시편 찬송 등이 포함되었다",
      "scope": "BERN_DISCUSSION_TOPICS"
    },
    {
      "id": "C397-07",
      "sources": [
        "HBBW3-228:s4"
      ],
      "grade": "FIRST_PERSON_PERSPECTIVE_NOT_GENERAL_THEOLOGICAL_FINALITY",
      "thesis_ko": "할러는 취리히 목회자들과 부처 측의 발언에서 다른 점을 듣지 못했다고 평가한다",
      "scope": "HALLER_REPORTED_LOCAL_AGREEMENT",
      "all_Lutheran_Zurich_eucharistic_divergence_resolved": false
    },
    {
      "id": "C397-08",
      "sources": [
        "HBBW3-228:s6",
        "HBBW3-228:s7",
        "HBBW3-228:s8"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "부처의 중재 아래 할러와 메간더 사이의 갈등이 대화로 완화되었다는 당사자 기록이 있다",
      "scope": "BERN_CLERICAL_MEDIATION"
    },
    {
      "id": "C397-09",
      "sources": [
        "HBBW3-228:s9"
      ],
      "grade": "DIRECT_EDITED_TEXT",
      "thesis_ko": "할러는 입으로만 아니라 마음까지 하나가 되기를 기원하며 지속 여부에 희망을 표한다",
      "scope": "CONTINUED_TENSION_NOT_GUARANTEED"
    },
    {
      "id": "C397-10",
      "sources": [
        "HBBW3-228:s20"
      ],
      "grade": "DIRECT_EDITED_TEXT_HEARSAY_OF_BUCER",
      "thesis_ko": "할러는 부처가 취리히의 불링거를 높이 평가했다고 전한다",
      "scope": "BUCER_CHARACTER_ASSESSMENT_VIA_HALLER"
    },
    {
      "id": "C397-11",
      "sources": [
        "HBBW3-219:s4"
      ],
      "grade": "AUTHOR_RETROSPECTIVE",
      "thesis_ko": "1533 공동 서신의 전년도 7월 회고와 현대 편집자의 1532년 6월 23일 서신 식별은 별개 층위다",
      "scope": "CRITICAL_EDITION_DATE"
    },
    {
      "id": "C397-12",
      "sources": [
        "HBBW3-219:s8",
        "HBBW3-228:s4"
      ],
      "grade": "COMPARATIVE_HISTORICAL_INFERENCE",
      "thesis_ko": "취리히의 미완의 성찬론 논쟁과 베른에서 보고된 실무적 화해는 서로 다른 수준의 일치다",
      "scope": "DO_NOT_MERGE_THEOLOGY_AND_MEDIATION"
    },
    {
      "id": "C397-13",
      "sources": [
        "S397-CAPITO2015-EP507-N3",
