  "historical_interpretation": {
    "primary_finding": "May 8 Zurich joint response preserves doctrinal disagreement with Luther; May 11 Bucer reports hopeful concord and mediation plans from Bern; May 11 Haller reports prospective settlement; May 29 Haller attests to meeting of 120 and pastoral reconciliation with Megander.",
    "continuity_limit": "The May 29 local reported agreement is not evidence that Zurich's May 8 refusal to assert Eucharistic doctrinal identity with Luther was rescinded; Haller reports his perspective.",
    "date_qualification": "1533 year is bracketed in editorial titles for Bucer 11 May and Haller 29 May although TEI when attribute resolves both to 1533.",
    "independent_participant_count": false,
    "actual_autograph_photographs_read": false,
    "synod_editorial_dates": "1533-05-12 to 1533-05-14 (Capito correspondence 2015, p.114 n.3)",
    "May29_is_report_not_synod_date": true
  },
