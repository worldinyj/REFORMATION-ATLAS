  "macro_arcs": [
    {
      "id": "A410-01",
      "title": "유럽 이전부터 있었던 아프리카 교회",
      "date_scope": "2~6세기 중심",
      "story": "알렉산드리아 교회의 신학·수도원과 악숨의 4세기 기독교는 근대 유럽 선교보다 훨씬 앞선 역사다. 악숨은 홍해 교역과 정치의 연결 속에서 신앙을 받아들였고, 이집트·에티오피아 교회는 독자적인 전례·언어·교회 전통을 발전시켰다.",
      "avoid": "아프리카 기독교가 19세기 유럽 선교의 도착과 함께 시작됐다고 설명하지 않는다.",
      "source_ids": [
        "S410-01",
        "S410-02",
        "S410-03"
      ],
      "region_ids": [
        "RG410-01"
      ],
      "level": "L0"
    },
    {
      "id": "A410-02",
      "title": "서아시아에서 인도양·당나라 중국으로",
      "date_scope": "5~15세기",
      "story": "시리아어 전례와 동방교회는 페르시아·인도양·실크로드를 통해 여러 언어권으로 연결됐다. 781년 시안 비문은 당나라의 기독교 공동체가 자신들의 과거를 어떻게 기념했는지 보여 준다. 인도 말라바르의 성 토마스 기독교 공동체도 포르투갈이 오기 전부터 존재했다.",
      "avoid": "사도 토마스가 1세기에 인도에 직접 왔다는 공동체 전승을 직접 검증된 역사적 날짜로 서술하지 않고, 781년 비문의 회고를 635년의 독립 자료와 동일시하지 않는다.",
