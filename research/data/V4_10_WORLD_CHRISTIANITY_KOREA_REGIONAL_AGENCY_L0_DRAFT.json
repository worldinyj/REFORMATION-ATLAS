  "comparative_questions": [
    {
      "id": "C410-01",
      "question": "아프리카·아시아 교회는 언제부터 있었는가?",
      "lesson": "고대 악숨과 이집트, 동방교회·말라바르를 19세기 유럽 선교의 전사(前史)로만 다루지 않는다.",
      "arc_ids": [
        "A410-01",
        "A410-02"
      ],
      "level": "L0"
    },
    {
      "id": "C410-02",
      "question": "같은 기독교를 받아들이는 선택이 같았는가?",
      "lesson": "콩고 왕실, 북미 원주민·흑인 교회, 태평양 섬주민의 수용·저항·자립은 서로 달랐다.",
      "arc_ids": [
        "A410-03",
        "A410-04",
        "A410-06"
      ],
      "level": "L0"
    },
    {
      "id": "C410-03",
      "question": "기독교와 식민주의는 언제 같은 방향으로 움직였는가?",
      "lesson": "라틴아메리카·아프리카·태평양에서 선교·권력·현지인 선택이 교차한 방식을 비교한다.",
      "arc_ids": [
        "A410-03",
        "A410-04",
        "A410-06"
      ],
      "level": "L0"
    },
    {
      "id": "C410-04",
      "question": "중국 기독교는 예수회가 처음 전했는가?",
      "lesson": "당나라의 동방교회와 명나라의 예수회 교류는 시기가 다른 두 역사다.",
      "arc_ids": [
        "A410-02",
        "A410-05"
      ],
      "level": "L0"
    },
    {
      "id": "C410-05",
      "question": "한국 천주교의 시작과 개신교의 시작은 같은가?",
      "lesson": "1784년 한국인 천주교 공동체와 1880년대 만주·일본 성경 번역 및 선교사 입국을 분리한다.",
      "arc_ids": [
        "A410-07",
        "A410-08"
      ],
      "level": "L0"
    },
    {
      "id": "C410-06",
      "question": "번역은 누구의 작업이었는가?",
      "lesson": "한국인 번역자·유통인과 외국인 선교사의 공동작업을 구분하고 이름별 구체 기여는 출처 범위를 따른다.",
      "arc_ids": [
        "A410-08"
      ],
      "level": "L0"
    },
    {
      "id": "C410-07",
      "question": "부흥은 사회 참여를 뜻하는가?",
      "lesson": "1907년 평양 부흥과 1919년 종교 연대·독립운동은 관련되지만 동일한 사건이 아니다.",
      "arc_ids": [
        "A410-08"
      ],
      "level": "L0"
    },
    {
      "id": "C410-08",
      "question": "세계교회를 누가 대표하는가?",
      "lesson": "1948년 WCC와 가톨릭·정교회·오순절·독립교회의 서로 다른 관계를 함께 본다.",
      "arc_ids": [
        "A410-09"
      ],
      "level": "L0"
