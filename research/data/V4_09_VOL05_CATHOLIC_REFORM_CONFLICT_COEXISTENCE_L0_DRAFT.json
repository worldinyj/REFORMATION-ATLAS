  "historical_arcs": [
    {
      "id": "A409-01",
      "title": "루터 이전부터 진행된 가톨릭 쇄신",
      "date_scope": "15세기 말~1545년",
      "summary": "가톨릭 개혁은 개신교 출현 뒤의 단순한 대응이 아니라 중세 후기 수도회·설교·목회·교육 개혁의 연속이었다.",
      "core_ko": "후기 중세 가톨릭 공동체 안에서는 수도생활을 정화하고, 성직자의 교육을 개선하며, 개인의 경건을 새롭게 하려는 요구가 존재했다. 16세기 개신교의 비판은 이 움직임에 새 긴장을 주었지만 모든 쇄신의 유일한 원인은 아니었다. 1520~1540년대에 새로운 수도회와 신심 공동체가 나타난 점도, 공의회가 열리기 전부터 변화를 준비했다는 사실을 보여 준다.",
      "questions": [
        "누가 교회의 생활을 바꾸려 했는가?",
        "그 개혁은 개신교의 등장과 어떤 관계를 가졌는가?"
      ],
      "source_ids": [
        "S409-01",
        "S409-03",
        "S409-17"
      ]
    },
    {
      "id": "A409-02",
      "title": "트리엔트 공의회: 신학적 정의와 제도 개혁",
      "date_scope": "1545~1563년",
      "summary": "세 시기에 걸쳐 교리의 경계를 명료화하고 감독·성직·교육의 제도적 기준을 정비했다.",
      "core_ko": "트리엔트 공의회는 1545~1547, 1551~1552, 1562~1563년의 세 시기에 걸쳐 열렸다. 성경과 전통, 칭의, 성례, 미사와 같은 쟁점을 정리하는 동시에 주교의 거주와 사목 책임, 성직자 교육, 신학교 설치 같은 개혁을 다뤘다. 명령이 내려졌다고 모든 교구가 즉시 같은 속도로 시행한 것은 아니다.",
      "questions": [
        "어떤 교리를 명확히 하려 했는가?",
        "결정이 실제 교구에 전달되는 데 왜 시간이 필요했는가?"
      ],
      "source_ids": [
        "S409-02",
        "S409-12",
        "S409-15"
      ]
    },
    {
      "id": "A409-03",
      "title": "수도회·영성·교육과 여성의 행위성",
      "date_scope": "1540~1600년대",
      "summary": "예수회의 교육·선교와 가르멜회 영성 개혁, 여성 공동체의 선택과 제한을 함께 읽는다.",
      "core_ko": "1540년에 승인을 받은 예수회는 학교·선교·신학 교육을 통해 넓은 네트워크를 만들었다. 아빌라의 테레사는 수도 공동체의 일상과 영적 훈련을 바꾸며 여성도 가톨릭 쇄신의 주요 행위자였다는 사실을 보여 준다. 동시에 여성의 공적 권위에는 한계가 있었고, 종교재판·검열 및 공동체 규율은 신앙의 표현을 통제하기도 했다. 교육과 통제가 같은 시대의 상반된 전개로 공존했다.",
      "questions": [
        "여성·평신도는 어떻게 종교 변화를 주도했는가?",
        "교육과 통제는 왜 같은 운동에서 병행됐는가?"
      ],
      "source_ids": [
        "S409-04",
        "S409-05",
        "S409-06",
        "S409-07",
        "S409-14"
      ]
    },
    {
      "id": "A409-04",
      "title": "교파의 경계와 유럽의 종교·왕권 갈등",
      "date_scope": "1540~1648년",
      "summary": "국가 권력과 교단 질서의 경쟁, 프랑스와 저지대의 전쟁, 제국의 30년 전쟁을 별개의 정치적 맥락으로 연결한다.",
      "core_ko": "신앙고백은 공동체와 국가가 자신들의 규칙을 분명히 만드는 언어가 되었지만, 강제와 폭력의 근거로도 사용됐다. 프랑스에서는 왕조와 귀족, 위그노 공동체의 갈등이 내전으로 이어졌다. 저지대에서는 종교 분열과 합스부르크 통치에 대한 저항이 얽혔다. 신성로마제국의 전쟁은 신학 대립으로만 설명되지 않으며, 가톨릭 프랑스가 합스부르크에 반대하는 세력과 협력한 정치적 선택도 포함해야 한다.",
      "questions": [
        "왜 같은 신학적 갈등이 지역에 따라 전쟁 또는 협상이 되었는가?",
        "왕조·재정·지정학은 신앙과 어떻게 얽혔는가?"
      ],
      "source_ids": [
        "S409-08",
        "S409-11",
        "S409-10",
        "S409-20"
      ]
    },
    {
      "id": "A409-05",
      "title": "화의와 관용의 한계",
      "date_scope": "1555~1648년",
      "summary": "아우크스부르크·토르다·바르샤바·낭트·베스트팔렌은 서로 다른 사람과 공동체를 보호한 제한적 합의다.",
      "core_ko": "1555년 아우크스부르크 화의는 제국에서 가톨릭과 루터파의 법적 관계를 재구성했다. 1568년 트란실바니아와 1573년 폴란드-리투아니아의 협상은 각기 다른 정치질서 속에서 종교적 공존을 다뤘다. 1598년 낭트 칙령은 프랑스 개혁파를 제한적으로 보호했고, 1648년의 조약들은 제국의 개혁파까지 인정 범위를 넓혔다. 그러나 그 어느 것도 모든 개인의 신앙 선택을 무제한 보장한 오늘날의 보편적 권리 선언은 아니다.",
      "questions": [
        "어떤 사람에게 어떤 보호가 허용됐는가?",
        "비슷한 관용이라는 말이 왜 지역마다 다른가?"
      ],
      "source_ids": [
        "S409-09",
        "S409-10",
        "S409-08",
        "S409-13",
        "S409-19"
      ]
    },
    {
      "id": "A409-06",
      "title": "유럽 너머의 연결: 선교와 현지 공동체",
      "date_scope": "16~17세기",
      "summary": "가톨릭 쇄신은 교육·대외선교와 연결되었으나 이 역사는 현지 신자와 제국 권력의 관계까지 함께 봐야 한다.",
      "core_ko": "예수회와 다른 종교 공동체는 유럽 내 학교를 만들고 아시아·아프리카·아메리카와 교류했다. 이 활동을 유럽인의 선교 성과만으로 설명하면 번역, 현지 신앙생활, 식민권력과의 협상 및 저항이 사라진다. 글로벌 전개는 VOL-06과 VOL-07에서 현지 공동체의 선택을 중심으로 확장하되, VOL-05에서는 유럽의 개혁이 세계와 이어지는 출발점으로 제시한다.",
      "questions": [
        "유럽 교회가 세계와 연결될 때 현지인들은 어떤 역할을 했는가?",
        "교육·전도와 식민지 권력의 관계는 어떻게 평가해야 하는가?"
      ],
      "source_ids": [
        "S409-04",
        "S409-06"
      ]
    }
