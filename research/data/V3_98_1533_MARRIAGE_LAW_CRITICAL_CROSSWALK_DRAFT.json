  "claims": [
    {
      "id": "CL398-01",
      "claim_ko": "1532년 Berner Synodus(편찬·문헌)와 1533년 5월 베른 시노드(회의)는 별개이다.",
      "source": [
        "ENGELER2023-P103-107",
        "CAPITO2015-P114N3"
      ],
      "tier": "SECONDARY_CHRONOLOGY"
    },
    {
      "id": "CL398-02",
      "claim_ko": "1533년 5월 13일 미코니우스는 바젤에서도 시노드를 열었다고 기록했다. 베른의 같은 주간 회의와 합치지 않는다.",
      "source": [
        "HBBW3-222:s12"
      ],
      "tier": "DIRECT_CRITICAL_TEI"
    },
    {
      "id": "CL398-03",
      "claim_ko": "1533년 5월 20일 취리히 혼인재판 관계자들은 다른 개혁 도시들과 혼인법을 협의하자고 제안했다.",
      "source": [
        "ZH-ARCH-A6-1-NR6"
      ],
      "tier": "OFFICIAL_ARCHIVE_DESCRIPTION"
    },
    {
      "id": "CL398-04",
      "claim_ko": "할러는 6월 8일 혼인법과 관례가 도시마다 같기를 바란다고 썼다.",
      "source": [
        "HBBW3-233:s19"
      ],
      "tier": "DIRECT_CRITICAL_TEI"
    },
    {
      "id": "CL398-05",
      "claim_ko": "메간더는 바젤·스트라스부르·콘스탄츠·울름·에슬링엔의 규정 등을 비교자료로 가져갔다.",
      "source": [
        "HBBW3-233:s21"
      ],
      "tier": "DIRECT_CRITICAL_TEI"
    },
    {
      "id": "CL398-06",
      "claim_ko": "6월 10일 취리히 예비회의에서 혼인법 44개 조항의 초안을 만들었다.",
      "source": [
        "ENGELER2023-P103-107"
      ],
      "tier": "SCHOLARLY_ANALYSIS_NOT_ORIGINAL_MINUTES"
    },
    {
      "id": "CL398-07",
      "claim_ko": "미코니우스와 바디안은 참석을 기대했지만 실제 6월 10일 회의에는 참석하지 않았다.",
      "source": [
        "HBBW3-233:s18",
        "ENGELER2023-P103-107"
      ],
      "tier": "SCHOLARLY_APPARATUS"
    },
    {
      "id": "CL398-08",
      "claim_ko": "7월 14일 할러는 베른 시의회가 초안을 두고 반발했으며 최종 결정은 자신이 알지 못한다고 썼다.",
      "source": [
        "HBBW3-241:s2",
        "HBBW3-241:s4"
      ],
      "tier": "DIRECT_CRITICAL_TEI"
    },
    {
      "id": "CL398-09",
      "claim_ko": "7월 15일 취리히에서 후속 협의가 개최되어 공동 규칙을 논의했다.",
      "source": [
        "ZH-ARCH-A6-1-NR7",
        "ENGELER2023-P103-107"
      ],
      "tier": "OFFICIAL_CATALOG_PLUS_SCHOLARSHIP"
    },
    {
      "id": "CL398-10",
      "claim_ko": "참가 도시들은 실질적으로 합의하지 못한 법적 세부사항을 남겼으며, 공통 조항의 전면 시행은 확인되지 않는다.",
      "source": [
        "ENGELER2023-P103-107"
      ],
      "tier": "SCHOLARLY_ANALYSIS"
    },
    {
      "id": "CL398-11",
      "claim_ko": "할러는 10월에도 두 도시의 차이에 안타까움을 표현했다. 이를 44개 조항 전면 통일의 증거로 바꿀 수 없다.",
      "source": [
        "HBBW3-275:s17",
        "HBBW3-275:s18"
      ],
      "tier": "DIRECT_CRITICAL_TEI"
    },
    {
      "id": "CL398-12",
      "claim_ko": "1532–1533년의 성찬 교리 논쟁 및 베른 목회자 갈등 조정과, 혼인법 협의는 서로 관련된 인적 네트워크이지만 별개 성과이다.",
      "source": [
        "HBBW3-233:s19",
        "ENGELER2023-P103-107",
        "CAPITO2015-P114N3"
      ],
      "tier": "INTERPRETIVE_BRIDGE"
    }
  ],
